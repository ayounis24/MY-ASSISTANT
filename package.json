{
  "name": "my-assistant",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest",
    "release:ios": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "register:device": "npx eas-cli@latest device:create",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview"
  },
  "private": true
}
